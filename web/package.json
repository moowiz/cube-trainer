{
  "name": "cube-scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest run --mode bench",
    "lint": "eslint src test scripts",
    "icons": "node scripts/make-icons.mjs",
    "check:detect": "node scripts/check-detect.mjs",
    "check:smart": "node scripts/check-smart.mjs",
    "check:record": "node scripts/check-record.mjs",
    "check:practice": "node scripts/check-practice.mjs",
    "check:ll": "node scripts/check-ll.mjs",
    "check:f2l": "node scripts/check-f2l.mjs",
    "check:rig": "node scripts/check-record.mjs --rig",
    "check:dead": "knip",
    "check:dup": "jscpd src",
    "check:size": "node scripts/check-size.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "maintain": "npm run check:dead && npm run check:dup && npm run check:audit && npm run build && npm run check:size"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "onnxruntime-web": "^1.30.0",
    "smartcube-web-bluetooth": "github:poliva/smartcube-web-bluetooth#44f1f091c6e980d9cc31e6d2863c4437eca3ab3c"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/pngjs": "^6.0.5",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "cubejs": "^1.3.2",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jscpd": "^5.3.2",
    "knip": "^6.38.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.12.0",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "cubejs": {
      "npm": "npm:empty-npm-package@1.0.0"
    }
  }
}
