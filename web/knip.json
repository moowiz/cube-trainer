{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/label-main.ts",
    "src/signin.ts",
    "src/solver.worker.ts",
    "src/colour/solve.worker.ts",
    "src/colour/sample.worker.ts",
    "src/detect/ort.worker.ts",
    "scripts/*.{mjs,ts}",
    "test/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.{mjs,ts}"
  ],
  "ignoreDependencies": [
    "cubing"
  ],
  "ignoreBinaries": [
    "tokens=5"
  ],
  "rules": {
    "duplicates": "off"
  }
}
